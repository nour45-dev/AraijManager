{
  "name": "araij-manager-pro",
  "version": "4.1.0",
  "description": "Araij Education Center Management Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "cap:init": "npx cap init \"سنتر الارائج\" com.araij.manager",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:build": "npx cap sync android && cd android && ./gradlew assembleRelease",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2"
  },
  "optionalDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/splash-screen": "^6.0.4"
  },
  "keywords": [
    "araij",
    "center",
    "education",
    "attendance",
    "railway",
    "pwa",
    "capacitor"
  ],
  "author": "Araij Center",
  "license": "ISC"
}
